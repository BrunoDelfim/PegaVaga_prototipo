{
  "manifest_version": 3,
  "name": "PegaVaga - Rastreamento de Vagas do LinkedIn",
  "version": "1.3.0",
  "description": "Automação de candidaturas e rastreamento de vagas no LinkedIn: busca por termo, cotas por hora/24h/dia, agendador de horários, ritmo humano com proteção da conta e exportação para Excel (CSV) com o motivo das vagas não candidatadas.",
  "icons": {
    "16": "icons/default_icon.png",
    "48": "icons/default_icon.png",
    "128": "icons/default_icon.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PegaVaga",
    "default_popup": "popup.html",
    "default_icon": "icons/default_icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
