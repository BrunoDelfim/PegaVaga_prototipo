# ============================================
# PegaVaga - .gitignore
# ============================================

# --- Sistema operacional ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores / IDEs ---
.vscode/
.idea/
*.swp
*.swo
.aider*
.clinerules
# Notas de handoff para o agente/editor: ficam locais, nao vao para o repo.
agent.md

# --- Dependencias ---
node_modules/

# --- Pacotes gerados ---
*.zip
*.crx
*.pem

# --- Relatorios exportados ---
pegavaga_*.csv

# --- Ambiente local (destinatario dos relatos, endpoint, token) ---
env.js

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
